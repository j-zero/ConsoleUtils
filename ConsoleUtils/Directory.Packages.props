<Project>

  <!-- Central package management: all NuGet versions are defined here. -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup>
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <PackageVersion Include="Mime" Version="3.6.0" />
    <PackageVersion Include="MimeTypesMap" Version="1.0.8" />
    <PackageVersion Include="System.Data.OleDb" Version="11.0.0" />
    <PackageVersion Include="System.Diagnostics.EventLog" Version="11.0.0" />
    <PackageVersion Include="System.Diagnostics.PerformanceCounter" Version="11.0.0" />
    <PackageVersion Include="System.Drawing.Common" Version="11.0.0" />
    <PackageVersion Include="System.Management" Version="11.0.0" />
    <PackageVersion Include="System.Security.Cryptography.ProtectedData" Version="11.0.0" />
    <PackageVersion Include="TimeZoneNames" Version="6.0.0" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

</Project>
